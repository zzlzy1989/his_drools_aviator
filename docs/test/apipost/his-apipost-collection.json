          "method": "POST",
          "url": "{{gateway_url}}/api/v1/flows/1/publish",
          "tests": [
            {"name": "发布成功", "assert": "response.json.code === '0'"}
          ]
        },
        {
          "name": "TC-RF-007: 获取规则流版本历史",
          "method": "GET",
          "url": "{{gateway_url}}/api/v1/flows/1/versions",
          "tests": [
