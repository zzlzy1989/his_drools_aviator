        {
          "name": "TC-RF-008: 回滚规则流",
          "method": "POST",
          "url": "{{gateway_url}}/api/v1/flows/1/rollback",
          "headers": {"Content-Type": "application/json"},
          "body": {
            "mode": "raw",
            "raw": {"targetVersion": 1, "changeDesc": "回滚到版本1"}
          },
          "tests": [
