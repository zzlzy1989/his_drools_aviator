{
  "apipost": {
    "info": {
      "name": "HIS Drools+Aviator 规则引擎 - API接口测试 (ApiPost版)",
      "description": "HIS动态规则中台完整接口测试集合 - 适配ApiPost平台\n\n测试覆盖:\n- 认证模块 (Auth)\n- 规则组管理 (Rule Groups)\n- 规则定义管理 (Rule Definitions)\n- 规则流管理 (Rule Flows)\n- 公式管理 (Formulas)\n- 结算管理 (Settlements)\n- 沙箱测试 (Sandbox)\n- 合理用药 (Drugs)\n- 质控指标 (Quality)\n- DRG分组 (DRG)\n- 系统监控 (Monitor)\n- 规则模板市场 (Market)\n- 审计日志 (Audit Logs)",
      "version": "1.0.0"
    },
    "environments": {
      "HIS测试环境": {
        "gateway_url": "http://localhost:9000",
        "rule_service_url": "http://localhost:9001",
        "settlement_service_url": "http://localhost:9002",
        "drug_service_url": "http://localhost:9003",
        "quality_service_url": "http://localhost:9004",
        "drg_service_url": "http://localhost:9005",
        "auth_token": "",
        "tenant_id": "tenant_demo_001",
        "user_id": "admin",
        "created_rule_id": "",
        "created_rule_group_id": "",
        "created_formula_id": "",
        "created_settlement_no": "",
        "created_flow_id": ""
      }
    }
  },
  "folders": [
    {
      "name": "01. 认证模块 (Auth)",
      "description": "用户登录、Token管理、用户信息获取",
      "items": [
        {
          "name": "TC-AUTH-001: 用户登录",
          "method": "POST",
          "url": "{{gateway_url}}/api/v1/auth/login",
          "headers": {"Content-Type": "application/json"},
          "body": {
            "mode": "raw",
            "raw": {"username": "admin", "password": "admin123", "tenantId": "{{tenant_id}}"}
          },
          "tests": [
            {"name": "状态码200", "assert": "response.status === 200"},
            {"name": "code字段存在", "assert": "response.json.code !== undefined"},
            {"name": "登录成功返回token", "assert": "response.json.code === '0' && response.json.data.token !== undefined"}
          ]
        },
        {
          "name": "TC-AUTH-002: 错误密码登录",
          "method": "POST",
          "url": "{{gateway_url}}/api/v1/auth/login",
          "headers": {"Content-Type": "application/json"},
          "body": {
            "mode": "raw",
            "raw": {"username": "admin", "password": "wrong_password", "tenantId": "{{tenant_id}}"}
          },
          "tests": [
            {"name": "登录失败", "assert": "response.json.code !== '0'"}
          ]
        },
        {
          "name": "TC-AUTH-003: 获取当前用户信息",
          "method": "GET",
          "url": "{{gateway_url}}/api/v1/auth/me",
          "headers": {
            "Authorization": "Bearer {{auth_token}}",
            "X-User-Id": "{{user_id}}",
            "X-Tenant-Id": "{{tenant_id}}"
          },
          "tests": [
            {"name": "状态码200", "assert": "response.status === 200"},
            {"name": "获取用户信息成功", "assert": "response.json.code === '0'"}
          ]
        }
      ]
    },
    {
      "name": "02. 规则组管理 (Rule Groups)",
      "description": "规则组CRUD、启用/禁用",
      "items": [
        {
          "name": "TC-RG-001: 获取规则组分页列表",
          "method": "GET",
          "url": "{{gateway_url}}/api/v1/rule-groups/page?page=1&pageSize=10",
          "tests": [
            {"name": "状态码200", "assert": "response.status === 200"},
            {"name": "返回分页数据", "assert": "response.json.code === '0' && response.json.data.list !== undefined"}
          ]
        },
        {
          "name": "TC-RG-002: 获取所有启用规则组",
          "method": "GET",
          "url": "{{gateway_url}}/api/v1/rule-groups",
          "tests": [
            {"name": "状态码200", "assert": "response.status === 200"},
            {"name": "返回数组", "assert": "response.json.code === '0' && Array.isArray(response.json.data)"}
          ]
        },
        {
          "name": "TC-RG-003: 创建规则组",
          "method": "POST",
          "url": "{{gateway_url}}/api/v1/rule-groups",
          "headers": {"Content-Type": "application/json"},
          "body": {
            "mode": "raw",
            "raw": {
              "groupCode": "TEST_GROUP_{{$timestamp}}",
              "groupName": "测试规则组_{{$timestamp}}",
              "description": "接口自动化测试创建",
              "priority": 10
            }
          },
          "tests": [
            {"name": "创建成功", "assert": "response.json.code === '0'"}
          ]
        },
        {
          "name": "TC-RG-004: 创建规则组-缺少必填字段",
          "method": "POST",
          "url": "{{gateway_url}}/api/v1/rule-groups",
          "headers": {"Content-Type": "application/json"},
          "body": {
            "mode": "raw",
            "raw": {"description": "缺少groupCode和groupName"}
          },
          "tests": [
            {"name": "参数校验失败", "assert": "response.json.code !== '0'"}
          ]
        },
        {
          "name": "TC-RG-005: 获取规则组详情",
          "method": "GET",
          "url": "{{gateway_url}}/api/v1/rule-groups/1",
          "tests": [
            {"name": "状态码200", "assert": "response.status === 200"}
          ]
        },
        {
          "name": "TC-RG-006: 获取不存在的规则组",
          "method": "GET",
          "url": "{{gateway_url}}/api/v1/rule-groups/999999",
          "tests": [
            {"name": "返回错误", "assert": "response.json.code !== '0'"}
          ]
        },
        {
          "name": "TC-RG-007: 更新规则组",
          "method": "PUT",
          "url": "{{gateway_url}}/api/v1/rule-groups/1",
          "headers": {"Content-Type": "application/json"},
          "body": {
            "mode": "raw",
            "raw": {"groupName": "更新后的规则组名称", "description": "更新描述", "priority": 20}
          },
          "tests": [
            {"name": "更新成功", "assert": "response.json.code === '0'"}
          ]
        },
        {
          "name": "TC-RG-008: 启用/禁用规则组",
          "method": "PUT",
          "url": "{{gateway_url}}/api/v1/rule-groups/1/enabled",
          "headers": {"Content-Type": "application/json"},
          "body": {
            "mode": "raw",
            "raw": {"isEnabled": false}
          },
          "tests": [
            {"name": "状态变更成功", "assert": "response.json.code === '0'"}
          ]
        },
        {
          "name": "TC-RG-009: 删除规则组",
          "method": "DELETE",
          "url": "{{gateway_url}}/api/v1/rule-groups/1",
          "tests": [
            {"name": "删除成功", "assert": "response.json.code === '0'"}
          ]
        }
      ]
    },
    {
      "name": "03. 规则定义管理 (Rule Definitions)",
      "description": "规则CRUD、校验、发布",
      "items": [
        {
          "name": "TC-RD-001: 获取规则分页列表",
          "method": "GET",
          "url": "{{gateway_url}}/api/v1/rules?page=1&pageSize=10",
          "tests": [
            {"name": "状态码200", "assert": "response.status === 200"},
            {"name": "返回分页数据", "assert": "response.json.code === '0'"}
          ]
        },
        {
          "name": "TC-RD-002: 按条件筛选规则",
          "method": "GET",
          "url": "{{gateway_url}}/api/v1/rules?page=1&pageSize=10&category=REIMBURSEMENT&status=1",
          "tests": [
            {"name": "状态码200", "assert": "response.status === 200"}
          ]
        },
        {
          "name": "TC-RD-003: 创建规则",
          "method": "POST",
          "url": "{{gateway_url}}/api/v1/rules",
          "headers": {"Content-Type": "application/json"},
          "body": {
            "mode": "raw",
            "raw": {
              "ruleKey": "rule.test.insurance_limit_{{$timestamp}}",
              "ruleName": "医保限额检查规则",
              "ruleText": "package com.his.rules.test;\nimport com.his.fact.SettlementFact;\nrule \"1. 限额检查\"\n    salience 50\n    when\n        $f: SettlementFact(totalFee > 10000)\n    then\n        log.warn(\"超过限额: \" + $f.getTotalFee());\nend",
              "category": "REIMBURSEMENT",
              "ruleGroupId": 1,
              "description": "接口测试创建的规则",
              "salience": 50
            }
          },
          "tests": [
            {"name": "创建成功", "assert": "response.json.code === '0'"}
          ]
        },
        {
          "name": "TC-RD-004: 创建规则-ruleKey格式错误",
          "method": "POST",
          "url": "{{gateway_url}}/api/v1/rules",
          "headers": {"Content-Type": "application/json"},
          "body": {
            "mode": "raw",
            "raw": {
              "ruleKey": "invalid_rule_key",
              "ruleName": "格式错误的规则",
              "ruleText": "package com.his.rules.test;",
              "category": "REIMBURSEMENT"
            }
          },
          "tests": [
            {"name": "格式校验失败", "assert": "response.json.code !== '0'"}
          ]
        },
        {
          "name": "TC-RD-005: 创建规则-DRL内容为空",
          "method": "POST",
          "url": "{{gateway_url}}/api/v1/rules",
          "headers": {"Content-Type": "application/json"},
          "body": {
            "mode": "raw",
            "raw": {
              "ruleKey": "rule.test.empty_{{$timestamp}}",
              "ruleName": "空DRL内容规则",
              "ruleText": "",
              "category": "REIMBURSEMENT"
            }
          },
          "tests": [
            {"name": "必填校验失败", "assert": "response.json.code !== '0'"}
          ]
        },
        {
          "name": "TC-RD-006: 获取规则详情",
          "method": "GET",
          "url": "{{gateway_url}}/api/v1/rules/1",
          "tests": [
            {"name": "状态码200", "assert": "response.status === 200"}
          ]
        },
        {
          "name": "TC-RD-007: 更新规则",
          "method": "PUT",
          "url": "{{gateway_url}}/api/v1/rules/1",
          "headers": {"Content-Type": "application/json"},
          "body": {
            "mode": "raw",
            "raw": {"ruleName": "更新后的规则名称", "description": "更新后的描述", "salience": 60}
          },
          "tests": [
            {"name": "更新成功", "assert": "response.json.code === '0'"}
          ]
        },
        {
          "name": "TC-RD-008: 校验规则",
          "method": "POST",
          "url": "{{gateway_url}}/api/v1/rules/1/validate",
          "tests": [
            {"name": "校验成功", "assert": "response.json.code === '0'"}
          ]
        },
        {
          "name": "TC-RD-009: 发布规则",
          "method": "POST",
          "url": "{{gateway_url}}/api/v1/rules/1/publish",
          "tests": [
            {"name": "发布成功", "assert": "response.json.code === '0'"}
          ]
        },
        {
          "name": "TC-RD-010: 删除规则",
          "method": "DELETE",
          "url": "{{gateway_url}}/api/v1/rules/1",
          "tests": [
            {"name": "删除成功", "assert": "response.json.code === '0'"}
          ]
        }
      ]
    },
    {
      "name": "04. 规则流管理 (Rule Flows)",
      "description": "流程定义、版本管理、导入导出、执行",
      "items": [
        {
          "name": "TC-RF-001: 获取规则流分页列表",
          "method": "GET",
