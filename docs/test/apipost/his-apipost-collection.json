                  {"nodeId": "node_2", "type": "RULE", "label": "身份校验", "ruleKey": "rule.validation.identity", "x": 300, "y": 100},
                  {"nodeId": "node_3", "type": "END", "label": "结束", "x": 500, "y": 100}
                ],
                "edges": [
                  {"source": "node_1", "target": "node_2", "label": ""},
                  {"source": "node_2", "target": "node_3", "label": ""}
