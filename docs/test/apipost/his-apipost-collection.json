        {
          "name": "TC-RF-009: 比较规则流版本",
          "method": "GET",
          "url": "{{gateway_url}}/api/v1/flows/1/compare?fromVersion=1&toVersion=2",
          "tests": [
            {"name": "状态码200", "assert": "response.status === 200"}
          ]
        },
        {
          "name": "TC-RF-010: 导出规则流",
          "method": "GET",
          "url": "{{gateway_url}}/api/v1/flows/1/export",
          "tests": [
