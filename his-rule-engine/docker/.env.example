# HIS 动态规则中台 - 环境变量配置模板
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 修改下面的配置值为实际环境值
# 3. 启动服务：docker-compose up -d

# ===== MySQL 配置 =====
# 数据库连接信息（支持宿主机或 Docker 内 MySQL）
MYSQL_HOST=192.168.1.105
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_password_here
MYSQL_DB=his_rule_engine

# ===== Redis 配置 =====
# Redis 连接信息（用于公式二级缓存）
REDIS_HOST=192.168.1.105
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Nacos 配置 =====
# Nacos 注册中心 + 配置中心地址
NACOS_ADDR=192.168.1.105:8848
# NACOS_NAMESPACE=          # 可选：命名空间 ID
# NACOS_GROUP=DEFAULT_GROUP # 可选：配置分组

# ===== JVM 参数 =====
# 各服务 JVM 内存配置（可根据服务器配置调整）
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# ===== Docker 构建参数 =====
# Maven 构建时跳过测试（生产部署建议设为 true）
MAVEN_SKIP_TESTS=true
